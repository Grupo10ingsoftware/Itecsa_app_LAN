# Copiar a deploy/mysql-lab.env (ignorado por Git) y reemplazar ambos marcadores.
# Estas variables solo inicializan un volumen de datos vacio.
MYSQL_ROOT_PASSWORD=<generar-clave-administrativa>
MYSQL_DATABASE=itecsa_lab
MYSQL_USER=itecsa_app
MYSQL_PASSWORD=<generar-clave-de-aplicacion-distinta>
MYSQL_MIGRATION_USER=itecsa_migrator
MYSQL_MIGRATION_PASSWORD=<generar-clave-de-migracion-distinta>
# Solo para entrega sin registro, tras verificar el archivo de imagen recibido:
# MYSQL_IMAGE=itecsa-mysql-lab:8.4.13
