# Variables de interpolación de Compose, no credenciales ni variables VITE de build.
# Copiar a deploy/production.env (ignorado) y completar con la release aprobada.
# Ejecutar desde la raíz: docker compose --env-file deploy/production.env -f compose.production.yaml ...
API_IMAGE=ghcr.io/grupo10ingsoftware/itecsa-app-api@sha256:<digest-api>
WEB_IMAGE=ghcr.io/grupo10ingsoftware/itecsa-app-web@sha256:<digest-web>
# Metadato de la pareja publicada; APP_VERSION se fija al construir las imágenes.
APP_VERSION=<sha-completo-del-commit>
# Origen público definitivo aprobado; sustituir también URLs públicas en WEB_ENV_FILE.
FRONTEND_ORIGIN=https://app.empresa.invalid
# Rutas respecto del directorio raíz de compose.production.yaml.
API_ENV_FILE=./capaServidor/.env
WEB_ENV_FILE=./capaVista/.env
DB_CA_FILE=./capaServidor/certs/aiven-ca.pem
# Opcionales; loopback supone un proxy local configurado aparte.
BIND_ADDRESS=127.0.0.1
API_PORT=3000
WEB_PORT=8080
TRUST_PROXY=0
# API_ENV_FILE: secretos backend, DB_* con TLS, PIN_SECRET e identidad HTTPS.
# WEB_ENV_FILE: solo configuración pública VITE_AUTH_PROVIDER/VITE_KEYCLOAK_*,
# VITE_API_BASE_URL o VITE_AUTH0_* si se elige expresamente el modo heredado.
# No usar HTTP/túnel/start-dev del desarrollo como configuración productiva.
