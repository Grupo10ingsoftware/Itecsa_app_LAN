# Copiar a deploy/mysql.env. Este archivo queda ignorado por Git.
# Identidad estable de la instalación: no cambiar después del primer install.
COMPOSE_PROJECT_NAME=itecsa-sitio
APP_VERSION=development
# El mismo stack de produccion se usa en servidor y pruebas locales aisladas.
# Usar otro COMPOSE_PROJECT_NAME y otros directorios de certificados para cada instalacion.
APP_RUNTIME_ENV=production
DEPLOY_IMAGE_MODE=build
# Recibo por entrega. Vacío conserva compatibilidad; se recomienda activarlo.
# Ejemplo: ./data/offline/itecsa-release.json (no reutilizar para otra revisión).
IMAGE_MANIFEST_FILE=

MYSQL_IMAGE=itecsa-mysql:8.4-pinned
API_IMAGE=itecsa-api:local
WEB_IMAGE=itecsa-web:local
DB_TOOLS_IMAGE=itecsa-db-tools:local
KEYCLOAK_IMAGE=itecsa-keycloak:local

API_ENV_FILE=./capaServidor/.env
WEB_ENV_FILE=./capaVista/.env
MYSQL_CERTS_DIR=./deploy/mysql/certs
MYSQL_PRIVATE_DIR=./deploy/mysql/private

MYSQL_ROOT_PASSWORD=<generar-clave-root>
MYSQL_DATABASE=itecsa
MYSQL_USER=itecsa_app
MYSQL_PASSWORD=<generar-clave-api-distinta>
MYSQL_MIGRATION_USER=itecsa_migrator
MYSQL_MIGRATION_PASSWORD=<generar-clave-migradora-distinta>
KEYCLOAK_DB_NAME=itecsa_keycloak
KEYCLOAK_DB_USER=itecsa_keycloak
KEYCLOAK_DB_PASSWORD=<generar-clave-keycloak-mysql>
KEYCLOAK_ADMIN_CLIENT_SECRET=<generar-secreto-client-32-caracteres>
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=<admin-temporal>
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=<generar-clave-admin-temporal>
KEYCLOAK_OPERATOR_USERNAME=<admin-permanente>
KEYCLOAK_OPERATOR_PASSWORD=<generar-clave-admin-permanente>

# Origen unico: certificado SAN y CA confiables para navegador, host y API.
PUBLIC_ORIGIN=https://<nombre-o-ip-lan>
LAN_CA_FILE=./deploy/https/private/ca.pem
LAN_TLS_CERT_FILE=./deploy/https/private/tls.crt
LAN_TLS_KEY_FILE=./deploy/https/private/tls.key
# Compatibilidad con configuraciones anteriores; runtime-install prepara ahora los permisos.
LAN_TLS_KEY_GID=101
LAN_BIND_ADDRESS=0.0.0.0

# Completar solo al ejecutar 'first-user'; borrar la contraseña temporal despues.
FIRST_USER_USERNAME=
FIRST_USER_EMAIL=
FIRST_USER_FIRST_NAME=
FIRST_USER_LAST_NAME=
FIRST_USER_RUT=
FIRST_USER_TEMP_PASSWORD=

BIND_ADDRESS=127.0.0.1
API_PORT=3000
WEB_PORT=8080
