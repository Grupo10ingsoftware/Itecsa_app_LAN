# Configuración PUBLICA. Nunca incluir passwords, PIN, tokens ni client secrets.
# Copiar solo si .env no existe; Vite se reinicia al cambiar estos valores.
# Selección explícita y coherente con AUTH_PROVIDER del backend.
VITE_AUTH_PROVIDER=keycloak

# Obligatorios en modo Keycloak. Direcciones del NAVEGADOR, nunca hostname Docker.
VITE_KEYCLOAK_URL=http://127.0.0.1:18080
VITE_KEYCLOAK_REALM=itecsa
VITE_KEYCLOAK_CLIENT_ID=itecsa-web
VITE_KEYCLOAK_AUDIENCE=https://api.itecsa.local
# Obligatoria para acceder al backend; incluye /api.
VITE_API_BASE_URL=http://127.0.0.1:3000/api

# Solo modo heredado VITE_AUTH_PROVIDER=auth0, conservado hasta retiro autorizado.
VITE_AUTH0_DOMAIN=<tenant>.auth0.com
VITE_AUTH0_CLIENT_ID=<client-id-spa>
VITE_AUTH0_AUDIENCE=https://api.itecsa.local

# Opcionales de compilación/desarrollo; no forman parte del runtime Nginx.
VITE_ENABLE_DEMO_ROUTES=false
# Consumido por la antigua SupportHomePage (sin ruta activa).
# La pantalla Usuarios vigente NO usa este flag; el montaje lo controla la API.
VITE_IDENTITY_PREPARATION=false

# Producción Docker: el entrypoint genera window.__ITECSA_CONFIG__ con proveedor,
# URLs y clientes públicos. No hace falta recompilar para cambiar esos campos.
# El entorno LAN de otros equipos requiere URL HTTPS/DNS aprobada y contexto PKCE.
# Mantener 127.0.0.1 para el entorno actual con iframe de sesión.
