      "sql": "SELECT page.*, totals.unreadCount FROM\n    (SELECT COUNT(*) AS unreadCount FROM MENSAJE_USUARIO WHERE id_usuario=?\n      AND `leido?`=0 AND `oculto?`=0) totals\n    LEFT JOIN (SELECT m.id_mensaje, m.contenido, m.fecha_publicacion, m.Asunto, m.id_pedido, mu.`leido?` AS leido, mu.`oculto?` AS oculto, p.id_pedido AS relatedId, p.numero_nota_venta, p.fecha_creacion, p.fecha_estimada_termino FROM MENSAJE_USUARIO mu JOIN Mensaje m ON m.id_mensaje=mu.id_mensaje LEFT JOIN Pedidos p ON p.id_pedido=m.id_pedido WHERE mu.id_usuario=?\n    AND mu.`leido?`=0 AND mu.`oculto?`=0\n    ORDER BY m.fecha_publicacion DESC, mu.id_mensaje DESC LIMIT ?) page ON TRUE ORDER BY page.fecha_publicacion DESC, page.id_mensaje DESC",
