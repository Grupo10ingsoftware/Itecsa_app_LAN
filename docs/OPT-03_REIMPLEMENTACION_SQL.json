  "sql": {
    "list_before": [
      "SELECT `Usuario`.`id_usuario`, `Usuario`.`correo_usuario`, `Usuario`.`rut_usuario`, `Usuario`.`nombre_usuario`, `Usuario`.`apellido_usuario`, `Usuario`.`rol_usuario`, `Usuario`.`estado_usuario` FROM `Usuario` LEFT JOIN `ExternalIdentity` AS `j0` ON (`j0`.`user_id`) = (`Usuario`.`id_usuario`) WHERE (`Usuario`.`rol_usuario` IN (?,?,?,?,?,?) AND (`j0`.`provider` = ? AND `j0`.`issuer` = ? AND (`j0`.`id_external_identity` IS NOT NULL))) ORDER BY `Usuario`.`id_usuario` DESC LIMIT ? OFFSET ?",
      "SELECT COUNT(*) AS `_count$_all` FROM (SELECT `Usuario`.`id_usuario` FROM `Usuario` LEFT JOIN `ExternalIdentity` AS `j0` ON (`j0`.`user_id`) = (`Usuario`.`id_usuario`) WHERE (`Usuario`.`rol_usuario` IN (?,?,?,?,?,?) AND (`j0`.`provider` = ? AND `j0`.`issuer` = ? AND (`j0`.`id_external_identity` IS NOT NULL)))) AS `sub`",
      "SELECT `ExternalIdentity`.`id_external_identity`, `ExternalIdentity`.`subject`, `ExternalIdentity`.`username`, `ExternalIdentity`.`user_id` FROM `ExternalIdentity` WHERE `ExternalIdentity`.`user_id` IN (?,?,?,?,?,?,?,?,?,?)"
