        "SELECT `Registro_Etapas`.`id_registro`, `Registro_Etapas`.`fecha_hora_entrada`, `Registro_Etapas`.`fecha_hora_salida`, `Registro_Etapas`.`id_estado_pedido` FROM `Registro_Etapas` WHERE (`Registro_Etapas`.`fecha_hora_entrada` >= ? AND `Registro_Etapas`.`fecha_hora_entrada` < ? AND `Registro_Etapas`.`fecha_hora_salida` IS NOT NULL)",
