  "sql": {
    "list": [
      "SELECT COUNT(*) AS `_count$_all` FROM (SELECT `Usuario`.`id_usuario` FROM `Usuario` LEFT JOIN `ExternalIdentity` AS `j0` ON (`j0`.`user_id`) = (`Usuario`.`id_usuario`) WHERE (`Usuario`.`rol_usuario` IN (?,?,?,?,?,?) AND (`j0`.`provider` = ? AND `j0`.`issuer` = ? AND (`j0`.`id_external_identity` IS NOT NULL)))) AS `sub`",
      "SELECT u.id_usuario, u.nombre_usuario, u.apellido_usuario,\n        u.rut_usuario, u.correo_usuario, u.rol_usuario, u.estado_usuario, e.subject, e.username\n        FROM Usuario u INNER JOIN ExternalIdentity e ON e.user_id = u.id_usuario\n        WHERE e.provider = 'keycloak' AND e.issuer = ? AND u.rol_usuario IN (?,?,?,?,?,?) ORDER BY u.id_usuario DESC LIMIT ? OFFSET ?"
    ],
    "summary": [
      "SELECT COUNT(*) AS `_count$_all`, `Usuario`.`estado_usuario` FROM `Usuario` LEFT JOIN `ExternalIdentity` AS `j0` ON (`j0`.`user_id`) = (`Usuario`.`id_usuario`) WHERE (`Usuario`.`rol_usuario` IN (?,?,?,?,?,?) AND (`j0`.`provider` = ? AND `j0`.`issuer` = ? AND (`j0`.`id_external_identity` IS NOT NULL))) GROUP BY `Usuario`.`estado_usuario`"
    ],
    "binding": [
      "SELECT e.id_external_identity, e.provider, e.issuer, e.subject, e.username, e.user_id,\n      u.id_usuario, u.rol_usuario, u.estado_usuario, u.correo_usuario, u.nombre_usuario, u.apellido_usuario\n      FROM ExternalIdentity e INNER JOIN Usuario u ON u.id_usuario = e.user_id\n      WHERE e.provider = 'keycloak' AND e.issuer = ? AND e.subject = ? LIMIT 1"
    ],
    "movements": [
      "SELECT COUNT(*) AS `_count$_all` FROM (SELECT `Registros`.`ID_REGISTRO` FROM `Registros` WHERE `Registros`.`id_usuario` = ?) AS `sub`",
      "SELECT r.ID_REGISTRO, r.FECHA_HORA, r.observacion,\n        rp.id_registro AS pagoId, ep.nombre_estado_pago AS pago,\n        re.id_registro AS etapaId, ee.nombre_etapa AS etapa,\n        rs.id_registro AS subprocesoId, es.nombre_estado AS subproceso\n        FROM Registros r\n        LEFT JOIN Registro_Pago rp ON rp.id_registro = r.ID_REGISTRO\n        LEFT JOIN Estado_Pago ep ON ep.id_estado_pago = rp.id_estado_pago_nuevo\n        LEFT JOIN Registro_Etapas re ON re.id_registro = r.ID_REGISTRO\n        LEFT JOIN Estado_Pedido ee ON ee.id_estado_pedido = re.id_estado_pedido\n        LEFT JOIN registro_subprocesos rs ON rs.id_registro = r.ID_REGISTRO\n        LEFT JOIN Estado_Subprocesos es ON es.id_estado_subproceso = rs.id_estado_subproceso\n        WHERE r.id_usuario = ? \n        ORDER BY r.FECHA_HORA DESC, r.ID_REGISTRO DESC LIMIT ? OFFSET ?"
    ],
