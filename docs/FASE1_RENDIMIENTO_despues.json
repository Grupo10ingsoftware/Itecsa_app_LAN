  "sql": {
    "legacy": [
      "SELECT `Usuario`.`id_usuario`, `Usuario`.`correo_usuario`, `Usuario`.`rut_usuario`, `Usuario`.`nombre_usuario`, `Usuario`.`apellido_usuario`, `Usuario`.`rol_usuario`, `Usuario`.`estado_usuario` FROM `Usuario` LEFT JOIN `ExternalIdentity` AS `j0` ON (`j0`.`user_id`) = (`Usuario`.`id_usuario`) WHERE (`j0`.`provider` = ? AND `j0`.`issuer` = ? AND `j0`.`subject` = ? AND (`j0`.`id_external_identity` IS NOT NULL)) LIMIT ? OFFSET ?",
      "SELECT `ExternalIdentity`.`id_external_identity`, `ExternalIdentity`.`provider`, `ExternalIdentity`.`issuer`, `ExternalIdentity`.`subject`, `ExternalIdentity`.`user_id` FROM `ExternalIdentity` WHERE `ExternalIdentity`.`user_id` IN (?)"
    ],
    "current": [
      "\n                SELECT u.id_usuario AS idUsuario, e.subject AS identitySubject,\n                    u.correo_usuario AS correoUsuario, u.rut_usuario AS rutUsuario,\n                    u.nombre_usuario AS nombreUsuario, u.apellido_usuario AS apellidoUsuario,\n                    u.rol_usuario AS rolUsuario, u.estado_usuario AS estadoUsuario\n                FROM ExternalIdentity e\n                INNER JOIN Usuario u ON u.id_usuario = e.user_id\n                WHERE e.provider = ? AND e.issuer = ? AND e.subject = ?\n                LIMIT 1\n            "
    ]
  },
