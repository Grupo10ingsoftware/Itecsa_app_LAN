# Copiar a .env.mysql-lab.docker.init. Uso exclusivo del servicio tools.
APP_ENV=development
NODE_ENV=development
DB_TARGET=mysql-lab-docker
DB_HOST=mysql
DB_PORT=3306
DB_USER=itecsa_app
DB_PASSWORD=<clave-usuario-aplicacion>
DB_NAME=itecsa_lab
DB_SSL_MODE=required
DB_SSL_CA_PATH=/run/secrets/mysql-lab-ca.pem
DB_MIGRATION_USER=itecsa_migrator
DB_MIGRATION_PASSWORD=<clave-usuario-migracion>
MYSQL_LAB_INIT_CONFIRM=itecsa_lab
MYSQL_LAB_INSTANCE_FILE=/run/mysql-lab-state/instance.env
