{
  "name": "capaservidor",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/app/app.js",
    "predev": "npm run prisma:generate",
    "dev": "nodemon src/app/dev.js",
    "prisma:pull": "node ../tooling/prisma/node_modules/prisma/build/index.js db pull",
    "prisma:generate": "node ../tooling/prisma/node_modules/prisma/build/index.js generate",
    "prisma:validate": "node ../tooling/prisma/node_modules/prisma/build/index.js validate",
    "prisma:migrate:dev": "node ../tooling/prisma/node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:status": "node ../tooling/prisma/node_modules/prisma/build/index.js migrate status",
    "prisma:seed": "node ../tooling/prisma/node_modules/prisma/build/index.js db seed --config prisma.config.ts",
    "mysql-lab:init": "node scripts/mysqlLabInitialize.mjs",
    "mysql-lab:catalogs": "node scripts/mysqlLabCatalogCheck.mjs",
    "mysql-lab:bootstrap-accounts": "node scripts/mysqlLabBootstrapAccounts.mjs",
    "mysql-lab:verify": "node scripts/mysqlLabVerify.mjs",
    "orders:preflight": "node scripts/ordersPreflight.mjs",
    "retention:preview": "node scripts/previewBusinessRetention.mjs",
    "prisma:studio": "node ../tooling/prisma/node_modules/prisma/build/index.js studio",
    "mysql:bootstrap-accounts": "node scripts/mysqlBootstrapAccounts.mjs",
    "mysql:deploy": "node scripts/mysqlDeploy.mjs",
    "mysql:verify": "node scripts/mysqlVerify.mjs",
    "mysql:maintenance": "node scripts/mysqlMaintenance.mjs",
    "mysql:generate-tls": "node scripts/mysqlGenerateTls.mjs",
    "mysql:backup": "node scripts/mysqlBackup.mjs",
    "mysql:restore": "node scripts/mysqlRestore.mjs",
    "keycloak:mysql-bootstrap": "node scripts/keycloakMysqlBootstrap.mjs",
    "keycloak:mysql-backup": "node scripts/keycloakMysqlBackup.mjs backup",
    "keycloak:mysql-restore": "node scripts/keycloakMysqlBackup.mjs restore",
    "keycloak:first-user": "node scripts/keycloakFirstUser.mjs",
    "manager:verify": "node scripts/managerVerify.mjs"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "../shared",
      "data/demo",
      ".env"
    ],
    "ext": "js,mjs,cjs,json,env",
    "signal": "SIGTERM"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-oauth2-jwt-bearer": "^1.10.0",
    "jose": "4.15.9",
    "mariadb": "3.5.4",
    "mssql": "^12.7.13"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "mariadb": "3.5.4",
    "mysql2": "3.24.4",
    "qs": "6.17.0",
    "fast-uri": "3.1.6"
  }
}
