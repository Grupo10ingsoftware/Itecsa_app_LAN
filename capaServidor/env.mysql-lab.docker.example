# Copiar a .env.mysql-lab.docker; perfil independiente del .env de Aiven.
APP_ENV=development
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=0
ENABLE_DEMO_ROUTES=false
SALES_NOTE_SOURCE=unavailable
PIN_DELIVERY_PROVIDER=disabled
PIN_SECRET=<generar-32-bytes-en-base64>
RATE_LIMIT_SECRET=<generar-secreto-de-laboratorio>
SECURITY_LOG_HMAC_KEY=<generar-secreto-de-laboratorio>
AUTH_PROVIDER=keycloak
KEYCLOAK_ALLOW_HTTP=true
KEYCLOAK_ISSUER=<issuer-keycloak-de-laboratorio>
KEYCLOAK_AUDIENCE=<audience-api-de-laboratorio>
KEYCLOAK_CLIENT_ID=<client-id-web-de-laboratorio>
KEYCLOAK_ROLE_CLIENT_ID=<client-id-api-de-laboratorio>
KEYCLOAK_JWKS_URI=<jwks-uri-accesible-desde-docker>

DB_TARGET=mysql-lab-docker
DB_HOST=mysql
DB_PORT=3306
DB_USER=itecsa_app
DB_PASSWORD=<clave-usuario-aplicacion>
DB_NAME=itecsa_lab
DB_SSL_MODE=required
DB_SSL_CA_PATH=/run/secrets/mysql-lab-ca.pem
# La cuenta CLI puede ser distinta. Esta ruta CA solo existe en el contenedor.
DATABASE_URL=mysql://itecsa_app:<clave-aplicacion-url-encoded>@mysql:3306/itecsa_lab?sslcert=/run/secrets/mysql-lab-ca.pem&sslaccept=strict
