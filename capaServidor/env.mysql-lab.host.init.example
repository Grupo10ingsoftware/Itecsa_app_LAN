# Copiar a .env.mysql-lab.host.init. Uso exclusivo del inicializador.
APP_ENV=development
NODE_ENV=development
DB_TARGET=mysql-lab-host
DB_HOST=127.0.0.1
DB_PORT=33307
DB_USER=itecsa_app
DB_PASSWORD=<clave-usuario-aplicacion>
DB_NAME=itecsa_lab
DB_SSL_MODE=required
DB_SSL_CA_PATH=<ruta-absoluta-a-ca.pem>
DB_MIGRATION_USER=itecsa_migrator
DB_MIGRATION_PASSWORD=<clave-usuario-migracion>
MYSQL_LAB_INIT_CONFIRM=itecsa_lab
MYSQL_LAB_INSTANCE_FILE=../deploy/mysql-lab/state/instance.env
