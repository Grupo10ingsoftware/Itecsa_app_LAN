# Ejemplo sin secretos. Copiar solo si .env no existe; completar con el responsable.
# O = obligatorio; opcional = valor por defecto o función deshabilitada.
# APP_ENV y NODE_ENV deben coincidir. Docker Compose fija ambos a development.
APP_ENV=development
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:5173
TRUST_PROXY=0
JSON_BODY_LIMIT=100kb
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
APP_VERSION=development

# Keycloak es el unico proveedor; una seleccion distinta se rechaza.
AUTH_PROVIDER=keycloak
# O en Keycloak. HTTP solo development/test con opt-in; producción exige HTTPS.
KEYCLOAK_ALLOW_HTTP=true
KEYCLOAK_ISSUER=http://127.0.0.1:18080/realms/itecsa
KEYCLOAK_AUDIENCE=https://api.itecsa.local
KEYCLOAK_CLIENT_ID=itecsa-web
KEYCLOAK_ROLE_CLIENT_ID=itecsa-api-v1
# O incluso si no hay administración. Ejemplo para Node local:
KEYCLOAK_JWKS_URI=http://127.0.0.1:18080/realms/itecsa/protocol/openid-connect/certs
# Mantener esta URL local en .env. compose.yaml sustituye SOLO el transporte
# dentro de Docker Desktop, sin cambiar issuer ni los vinculos de identidad.

# Administración Keycloak: opcional, necesaria al habilitar preparación fase 06.
# false deshabilita el montaje administrativo; no entrega credenciales ni activa.
IDENTITY_PREPARATION_ENABLED=false
KEYCLOAK_ADMIN_CLIENT_ID=itecsa-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_TIMEOUT_MS=5000
# Node local: dejar sin definir usa issuer.origin. compose.yaml define el
# transporte interno de Docker Desktop. Este override NO se admite en production.
# Nunca cambiar issuer para llegar a Docker.

# O: claves privadas del backend. No copiar los placeholders como valores reales.
# PIN_SECRET: exactamente 32 bytes base64; CONSERVAR el actual con la misma base.
PIN_SECRET=<32-bytes-en-base64>
RATE_LIMIT_SECRET=<32-bytes-en-base64>
SECURITY_LOG_HMAC_KEY=<32-bytes-en-base64>
# Opcional: si falta, usa RATE_LIMIT_SECRET (excepto fallback propio de tests).
CURSOR_SECRET=<32-bytes-en-base64>

# O al acceder a MySQL. Datos suministrados por el responsable de Aiven.
# Runtime usa DB_*; DATABASE_URL se usa por Prisma CLI, debe apuntar a la misma base.
DB_TARGET=aiven
DB_HOST=<host-aiven>
DB_PORT=<puerto-aiven>
DB_USER=<usuario-aiven>
DB_PASSWORD=
DB_NAME=<nombre-bd>
DB_SSL_MODE=required
# Ruta relativa a capaServidor en Node local; Compose monta CA en /run/secrets/.
DB_SSL_CA_PATH=./certs/aiven-ca.pem
DB_CONNECT_TIMEOUT_MS=8000
DB_QUERY_TIMEOUT_MS=15000
# URL ilustrativa: codificar caracteres reservados de usuario/password al completarla.
DATABASE_URL=mysql://<usuario>:<password-url-encoded>@<host>:<puerto>/<base>?sslcert=./certs/aiven-ca.pem&sslaccept=strict

# Notas de venta sintéticas solo desarrollo/tests; Manager todavía no integrado.
# Si falta o unavailable, la consulta de NV responde indisponibilidad.
SALES_NOTE_SOURCE=fixture
ENABLE_DEMO_ROUTES=false

# disabled es seguro sin credenciales; resend exige API key y remitente verificado.
# fake solo test; console solo development con selección explícita.
# Recuperacion de PIN por email, independiente de la contraseña.
PIN_DELIVERY_PROVIDER=disabled
RESEND_API_KEY=
PIN_EMAIL_FROM=

# Opcional: readiness interno. Token obligatorio al habilitarlo en production.
ENABLE_INTERNAL_READINESS=false
INTERNAL_HEALTH_TOKEN=
# Opcional: observación de NV (no activa bloqueos).
SECURITY_MONITOR_WINDOW_SECONDS=300
SECURITY_MONITOR_LOOKUP_SIGNAL_THRESHOLD=30
SECURITY_MONITOR_NOT_FOUND_SIGNAL_THRESHOLD=10

# Opcional: limpiezas. No habilitar borrado siguiendo una guía de arranque.
TEMPORARY_DATA_CLEANUP_INTERVAL_MS=3600000
PIN_RECOVERY_RETENTION_MODE=disabled
PIN_RECOVERY_RETENTION_DAYS=
BUSINESS_RETENTION_MODE=disabled

# Opcional: P18/P19. resend exige destinatario/remitente, RESEND_API_KEY y RATE_LIMIT_SECRET.
PRIVACY_REQUEST_PROVIDER=disabled
PRIVACY_REQUEST_RECIPIENT=
PRIVACY_REQUEST_FROM=
PRIVACY_DOCUMENT_NOTICE_URL=
PRIVACY_DOCUMENT_NOTICE_VERSION=
PRIVACY_DOCUMENT_TERMS_URL=
PRIVACY_DOCUMENT_TERMS_VERSION=
PRIVACY_DOCUMENT_POLICY_URL=
PRIVACY_DOCUMENT_POLICY_VERSION=
PRIVACY_DOCUMENT_PROCEDURE_URL=
PRIVACY_DOCUMENT_PROCEDURE_VERSION=
SECURITY_INCIDENT_PROVIDER=disabled
SECURITY_INCIDENT_RECIPIENT=
SECURITY_INCIDENT_FROM=
