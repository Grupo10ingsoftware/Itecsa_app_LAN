# Copiar a capaServidor/.env. El Compose integrado configura MySQL local, Keycloak,
# origen HTTPS y Gestion de usuarios (IDENTITY_PREPARATION_ENABLED=true).
# Completar los cuatro secretos con valores distintos: openssl rand -base64 32.
APP_ENV=production
NODE_ENV=production
PORT=3000
ENABLE_DEMO_ROUTES=false
SALES_NOTE_SOURCE=unavailable

# Fuente SQL Server de Notas de Venta. Se valida solo con SALES_NOTE_SOURCE=manager.
# La cuenta debe usar autenticacion SQL y permisos minimos sobre los procedimientos.
MANAGER_DB_HOST=<host-sql-server>
MANAGER_DB_PORT=1433
MANAGER_DB_NAME=MiniManagerItecsaCSV
MANAGER_DB_USER=<usuario-solo-lectura>
MANAGER_DB_PASSWORD=
MANAGER_DB_ENCRYPT=true
MANAGER_DB_TRUST_SERVER_CERTIFICATE=false
MANAGER_DB_CONNECT_TIMEOUT_MS=8000
MANAGER_DB_REQUEST_TIMEOUT_MS=15000
MANAGER_DB_POOL_MAX=5
MANAGER_DB_POOL_IDLE_TIMEOUT_MS=30000
MANAGER_SALES_NOTE_LOOKBACK_DAYS=5

PIN_SECRET=<32-bytes-en-base64>
RATE_LIMIT_SECRET=<32-bytes-en-base64>
SECURITY_LOG_HMAC_KEY=<32-bytes-en-base64>
CURSOR_SECRET=<32-bytes-en-base64>

PIN_DELIVERY_PROVIDER=disabled
PRIVACY_REQUEST_PROVIDER=disabled
SECURITY_INCIDENT_PROVIDER=disabled
