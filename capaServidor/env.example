# Copiar a capaServidor/.env. El Compose integrado inyecta la conexion MySQL local.
APP_ENV=production
NODE_ENV=production
PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:8080
TRUST_PROXY=0
ENABLE_DEMO_ROUTES=false
SALES_NOTE_SOURCE=unavailable

AUTH_PROVIDER=keycloak
KEYCLOAK_ALLOW_HTTP=false
KEYCLOAK_ISSUER=<issuer-keycloak>
KEYCLOAK_AUDIENCE=<audience-api>
KEYCLOAK_CLIENT_ID=itecsa-web
KEYCLOAK_ROLE_CLIENT_ID=itecsa-api-v1
KEYCLOAK_JWKS_URI=<jwks-uri-accesible-desde-docker>
IDENTITY_PREPARATION_ENABLED=false
KEYCLOAK_ADMIN_CLIENT_ID=itecsa-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=

PIN_SECRET=<32-bytes-en-base64>
RATE_LIMIT_SECRET=<32-bytes-en-base64>
SECURITY_LOG_HMAC_KEY=<32-bytes-en-base64>
CURSOR_SECRET=<32-bytes-en-base64>

KEYCLOAK_PIN_RECOVERY_CLIENT_ID=itecsa-pin-recovery
KEYCLOAK_PIN_RECOVERY_REDIRECT_URI=http://127.0.0.1:8080/auth/pin-recovery/callback
PIN_DELIVERY_PROVIDER=disabled
PRIVACY_REQUEST_PROVIDER=disabled
SECURITY_INCIDENT_PROVIDER=disabled
